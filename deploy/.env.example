# Copy to /opt/nascon/.env on the server and fill in the secrets.
#
#   cp deploy/.env.example /opt/nascon/.env
#   $EDITOR /opt/nascon/.env
#
# This file is read by docker compose itself (for ${VARIABLES}) and is never
# committed. Every value here is passed into the containers as a real environment
# variable, so nothing depends on a bind-mounted .env inside the images.

# ------------------------------------------------------------------ #
# Image naming
# ------------------------------------------------------------------ #
# REGISTRY is the namespace images are published to. The GitHub Actions workflow
# sets it to ghcr.io/<owner>/<repo>; for a local build anything works.
REGISTRY=ghcr.io/your-github-owner/your-repo
# Overridden per deploy by the workflow with the commit SHA. "latest" is the default
# for a plain `docker compose build`.
IMAGE_TAG=latest

# ------------------------------------------------------------------ #
# Public surface
# ------------------------------------------------------------------ #
PUBLIC_ORIGIN=https://nascon.artdevelopers.site
# Host port the frontend container binds to (loopback only). The host nginx proxies
# the domain here.
FRONTEND_PORT=8085

# ------------------------------------------------------------------ #
# RabbitMQ — the audio queue
# ------------------------------------------------------------------ #
RABBITMQ_USER=comsats
RABBITMQ_PASSWORD=change-me-to-a-long-random-string
RABBITMQ_VHOST=comsats
RABBITMQ_AUDIO_QUEUE=voice.audio
RABBITMQ_JOB_TIMEOUT=180

# ------------------------------------------------------------------ #
# Redis — cache, rate limiting, sessions, anything keyed and short-lived
# ------------------------------------------------------------------ #
# The redis container is reachable as redis:6379 inside the compose network and is not
# published to the host. Only change this if you point the app at an external Redis.
# Leave it unset to disable Redis entirely; the helpers in backend/src/lib/redis.js
# no-op when there is no URL.
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------ #
# Observability — Prometheus + Grafana
# ------------------------------------------------------------------ #
# Grafana is served under https://<domain>/grafana/ and is the only public part of the
# monitoring stack; Prometheus and the exporters stay on the compose network.
# Required: the stack refuses to start without it.
#   openssl rand -hex 16
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-to-a-long-random-string
GRAFANA_ROOT_URL=https://nascon.artdevelopers.site/grafana/

# ------------------------------------------------------------------ #
# Auth
# ------------------------------------------------------------------ #
# Must be a long random string: the API refuses to boot in production without it.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------ #
# Cloudinary (document and photo uploads)
# ------------------------------------------------------------------ #
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=comsats-abbottabad

# ------------------------------------------------------------------ #
# Groq (chat answers + Whisper speech-to-text)
# ------------------------------------------------------------------ #
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low
GROQ_MAX_TOKENS=320

# ------------------------------------------------------------------ #
# Retrieval
# ------------------------------------------------------------------ #
RAG_TOP_K=3
RAG_MIN_SCORE=0.05
EMBED_MODEL=BAAI/bge-small-en-v1.5
CHROMA_COLLECTION_PREFIX=sem-

# ------------------------------------------------------------------ #
# Voice
# ------------------------------------------------------------------ #
VOICE_STT_MODEL=whisper-large-v3-turbo
VOICE_STT_LANGUAGE=en
VOICE_TTS_VOICE=en-US-AriaNeural
VOICE_VAD_THRESHOLD_DB=-38
VOICE_VAD_HANGOVER_MS=350
VOICE_VAD_MIN_SPEECH_MS=180

# ------------------------------------------------------------------ #
# Binance — READ ONLY. The key must have "Enable Reading" only:
# no spot/margin trading, no futures, no withdrawals, plus an IP allowlist.
# ------------------------------------------------------------------ #
BINANCE_BASE_URL=https://api.binance.com
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_DEPOSIT_COIN=USDT
BINANCE_DEPOSIT_NETWORK=TRX
PAYMENT_TOLERANCE_PERCENT=10
PAYMENT_POLL_SECONDS=30
