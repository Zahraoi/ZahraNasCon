# ------------------------------------------------------------------ #
# Backend API + AI service configuration.
#
# Both processes read this one file: the API via dotenv, the Python service via
# its own loader (it looks for ../backend/.env by default, or ENV_FILE).
#
#   cp backend/.env.example backend/.env
#
# In Docker none of this is used — every value below is passed as a container
# environment variable from deploy/.env instead. See deploy/README.md.
# ------------------------------------------------------------------ #

# --- Server ------------------------------------------------------- #
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173

# --- Auth --------------------------------------------------------- #
# Change this to a long random string before deploying. The API refuses to start
# with NODE_ENV=production unless this is set.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# --- Cloudinary (document and photo uploads) ---------------------- #
# dashboard > Account details
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Optional: the SDK also reads this form.
# CLOUDINARY_URL=cloudinary://api-key:api-secret@cloud-name
CLOUDINARY_FOLDER=comsats-abbottabad

# --- Groq (chat answers + Whisper speech-to-text) ----------------- #

# console.groq.com/keys. List the models your key can use with:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_API_KEY=your-groq-api-key
# The gpt-oss models are reasoning models: 20b is the fast default, 120b is
# smarter but noticeably slower.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low
GROQ_MAX_TOKENS=320
# GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions

# --- Retrieval ---------------------------------------------------- #
RAG_TOP_K=4
RAG_MIN_SCORE=0.05
# Where the built-in vector store persists when Chroma is unavailable.
# RAG_DATA_DIR=
RAG_CHUNK_TARGET=900
RAG_CHUNK_OVERLAP=150

# --- Vector database ---------------------------------------------- #
# You normally never start Chroma by hand: `python AI/main.py` (npm run embed)
# starts it as a child process and stops it on Ctrl+C.
#   CHROMA_AUTOSTART=false      manage it yourself
#   CHROMA_AUTOSTART=false      (and set CHROMA_HOST) when it runs as a container
CHROMA_URL=http://localhost:8000
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_AUTOSTART=true
# Collections are prefixed per embedder, so switching models starts a fresh index
# instead of silently mixing vectors.
CHROMA_COLLECTION_PREFIX=sem-
# CHROMA_DATA_DIR=
# CHROMA_TENANT=default_tenant
# CHROMA_DATABASE=default_database

# --- Embeddings (semantic search) --------------------------------- #
# Groq serves generation only — it has no embedding models. Embeddings come from
# a local sentence-transformer served by the Python service:
#   pip install fastembed flask flask-cors
#   python AI/main.py
EMBEDDINGS_URL=http://127.0.0.1:8100
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_HOST=127.0.0.1
EMBED_PORT=8100
RAG_USE_SEMANTIC=true
RAG_USE_CHROMA=true

# --- Audio queue (RabbitMQ) --------------------------------------- #
# Audio turns are published to this queue and drained by a single consumer with
# prefetch_count=1, so two recordings can never be transcribed or spoken over
# each other. Without a URL the service falls back to an in-process lock.
#
# The password must be URL-safe (hex is fine) because it is embedded in the URL.
# Locally this points at the broker on the VM; in Docker it is the rabbitmq
# service on the compose network.
RABBITMQ_URL=amqp://comsats:CHANGE_ME@127.0.0.1:5672/comsats
RABBITMQ_AUDIO_QUEUE=voice.audio
RABBITMQ_JOB_TIMEOUT=180

# --- Voice (served by the Python service on :8100) ---------------- #
# Speech in: Groq Whisper. Speech out: edge-tts, then Windows SAPI as a fallback.
VOICE_STT_MODEL=whisper-large-v3-turbo
VOICE_STT_LANGUAGE=en
# Bias the decoder towards campus vocabulary so "COMSATS" survives transcription.
VOICE_STT_PROMPT=COMSATS Abbottabad campus. Admission dates, semester fees, programmes, attendance.
VOICE_TTS_VOICE=en-US-AriaNeural
VOICE_SAPI_VOICE=Microsoft Zira Desktop
# Voice activity detection
VOICE_VAD_THRESHOLD_DB=-38
VOICE_VAD_FRAME_MS=30
VOICE_VAD_HANGOVER_MS=350
VOICE_VAD_MIN_SPEECH_MS=180

# --- Redis --------------------------------------------------------- #
# Optional. The redis container is only reachable inside the compose network on the
# deployment host, so a local process normally cannot use it. With no URL the helpers in
# src/lib/redis.js no-op, which is the intended local behaviour. Point this at your own
# Redis if you want to exercise caching locally.
# REDIS_URL=redis://127.0.0.1:6379

# --- Deployment status reporting ----------------------------------- #
# Only the deploy pipeline sets this. Unset means POST /api/deploy/status does not exist.
# DEPLOY_STATUS_TOKEN=

# --- WhatsApp (whatsapp-web.js) ----------------------------------- #
# Link a device once with:  npm --prefix backend run whatsapp:pair
# A linked session auto-connects on boot regardless of this flag, so scanning is
# a one-time step. Set it to true only to force a start with no session yet.
WHATSAPP_ENABLED=false
WHATSAPP_REPLY_TO_GROUPS=false
WHATSAPP_ALLOW_UNKNOWN=true
# WHATSAPP_SESSION_PATH=
# WHATSAPP_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# --- Binance — READ ONLY ------------------------------------------ #
# The key must have "Enable Reading" only: no spot/margin trading, no futures,
# no withdrawals, plus an IP allowlist. The code has no order, transfer or
# withdrawal path at all.
BINANCE_BASE_URL=https://api.binance.com
# Defaults to the futures host derived from BINANCE_BASE_URL.
# BINANCE_FUTURES_URL=https://fapi.binance.com
BINANCE_API_KEY=your-binance-api-key
BINANCE_API_SECRET=your-binance-api-secret
BINANCE_DEPOSIT_COIN=USDT
BINANCE_DEPOSIT_NETWORK=TRX

# --- Subscription payments ---------------------------------------- #
# How far a deposit may differ from the plan price and still settle.
PAYMENT_TOLERANCE_PERCENT=10
# How often the backend checks Binance for incoming deposits.
PAYMENT_POLL_SECONDS=30
