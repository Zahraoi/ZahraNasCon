{
  "name": "comsats-backend",
  "version": "1.0.0",
  "private": true,
  "description": "COMSATS Abbottabad school management API",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "seed": "node src/seed.js",
    "whatsapp:pair": "node src/scripts/whatsapp.js pair",
    "whatsapp:status": "node src/scripts/whatsapp.js status",
    "whatsapp:logout": "node src/scripts/whatsapp.js logout"
  },
  "keywords": [
    "school-management",
    "express",
    "auth"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "chromadb": "^3.5.0",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "redis": "^6.3.0",
    "whatsapp-web.js": "^1.34.7"
  }
}
